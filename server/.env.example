# MediQueue API configuration
# Copy this file to .env and adjust values.

PORT=5100

# Local MongoDB. Change if you use Atlas or a different instance.
MONGODB_URI=mongodb://127.0.0.1:27017/mediqueue_app

# Secret used to sign JWTs. Change this in any real deployment.
JWT_SECRET=mediqueue-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS.
CLIENT_ORIGIN=http://localhost:5174