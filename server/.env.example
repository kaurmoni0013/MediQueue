# MediQueue API configuration
# Copy this file to .env and adjust values.

PORT=5100

# Local MongoDB. Change if you use Atlas or a different instance.
MONGODB_URI=mongodb://127.0.0.1:27017/mediqueue_app

# Secret used to sign JWTs. MUST be a strong random value in any real deployment —
# the server refuses to start in production mode if this default is left in place.
JWT_SECRET=generate-a-long-random-string-here
JWT_EXPIRES_IN=1d

# Frontend origin allowed by CORS.
CLIENT_ORIGIN=http://localhost:5174

# Production deployment.
NODE_ENV=development
# When true (and only then), the API seeds fresh demo data on first boot if the
# database is empty. Safe to leave on — it never wipes existing data.
SEED_DEMO_DATA=false

# SMTP for password-reset emails. Leave empty to run in demo mode, where the
# reset link is printed to the server console instead of being emailed.
# (Example: Brevo free tier — SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MediQueue <no-reply@mediqueue.com>